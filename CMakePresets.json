{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "OCCLUSION_BUILD_TESTS": "ON",
        "OCCLUSION_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "native-debug",
      "inherits": "native-base",
      "displayName": "Native Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-base",
      "displayName": "Native Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OCCLUSION_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "collision-debug",
      "inherits": "native-base",
      "displayName": "Collision Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OCCLUSION_ENABLE_COLLISION": "ON",
        "VCPKG_MANIFEST_FEATURES": "collision"
      }
    },
    {
      "name": "collision-release",
      "inherits": "native-base",
      "displayName": "Collision Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OCCLUSION_ENABLE_COLLISION": "ON",
        "OCCLUSION_BUILD_TESTS": "OFF",
        "VCPKG_MANIFEST_FEATURES": "collision"
      }
    },
    {
      "name": "collision-sanitizers",
      "inherits": "collision-debug",
      "displayName": "Collision ASan/UBSan",
      "cacheVariables": {
        "OCCLUSION_ENABLE_SANITIZERS": "ON",
        "VCPKG_MANIFEST_FEATURES": "collision"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "collision-debug",
      "configurePreset": "collision-debug"
    },
    {
      "name": "collision-release",
      "configurePreset": "collision-release"
    },
    {
      "name": "collision-sanitizers",
      "configurePreset": "collision-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "collision-debug",
      "configurePreset": "collision-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "collision-sanitizers",
      "configurePreset": "collision-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "collision-release",
      "configurePreset": "collision-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
