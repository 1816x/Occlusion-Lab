{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "OCCLUSION_BUILD_TESTS": "ON",
        "OCCLUSION_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "native-debug",
      "inherits": "native-base",
      "displayName": "Native Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "native-release",
      "inherits": "native-base",
      "displayName": "Native Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OCCLUSION_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
