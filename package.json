{
  "name": "occlusion-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Educational occlusion simulation research sandbox (work in progress).",
  "scripts": {
    "predev": "npm run assets:generate",
    "dev": "next dev",
    "prebuild": "npm run assets:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run assets:generate",
    "test": "vitest run && npm run check:rapier-thread",
    "assets:generate": "node scripts/generate-phase1-fixture.mjs",
    "assets:verify": "npm run assets:generate && node scripts/verify-phase1-fixture.mjs",
    "check:rapier-thread": "node scripts/checks/no-main-thread-rapier.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.3.0",
    "gltf-pipeline": "^4.3.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
