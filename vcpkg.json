{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "occlusion-lab",
  "version-semver": "0.4.0",
  "builtin-baseline": "f3457518c19c4efdb3b9307a8bb4e27d4b989933",
  "dependencies": [
    "eigen3",
    { "name": "gtest", "host": true }
  ],
  "features": {
    "geometry": { "description": "Future robust mesh processing", "dependencies": ["cgal"] },
    "collision": { "description": "Future collision and distance queries", "dependencies": ["fcl"] },
    "desktop": {
      "description": "Future Qt 6 and VTK presentation stack",
      "dependencies": [
        { "name": "qtbase", "default-features": false },
        { "name": "vtk", "default-features": false }
      ]
    }
  }
}
