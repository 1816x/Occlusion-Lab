{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "occlusion-lab",
  "version-semver": "0.5.0",
  "builtin-baseline": "f3457518c19c4efdb3b9307a8bb4e27d4b989933",
  "dependencies": [
    "eigen3",
    "gtest",
    "nlohmann-json"
  ],
  "features": {
    "geometry": {
      "description": "Optional CGAL synthetic mesh inspection",
      "dependencies": [
        "cgal"
      ]
    },
    "collision": {
      "description": "Future collision and distance queries",
      "dependencies": [
        "fcl"
      ]
    },
    "desktop": {
      "description": "Optional Qt 6 and VTK desktop viewer",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["concurrent", "gui", "opengl", "widgets"]
        },
        {
          "name": "vtk",
          "default-features": false
        }
      ]
    }
  }
}
